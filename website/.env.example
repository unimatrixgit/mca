# Configure these values as server-side Sites environment variables.
# Never put a real bot token into this file or browser JavaScript.
DISCORD_BOT_TOKEN=
DISCORD_PUBLISHER_ID=
DISCORD_EXCHANGE_CHANNEL_ID=
DISCORD_NEWS_CHANNEL_ID=

# Comma-separated staff account emails; store as secrets in Sites.
FORUM_ADMIN_EMAILS=
SUPPORT_STAFF_EMAILS=

DISCORD_DIPLOMACY_CHANNEL_ID=

# Read-only HTTPS endpoint for sanitized PostgreSQL exchange listings (server-side only)
EXCHANGE_LISTINGS_URL=
EXCHANGE_READ_TOKEN=

# Optional private read-only PostgreSQL role for CP inventory/sales.
# Never use the game writer role or publish this URL to browser code.
DUNE_INVENTORY_DATABASE_URL=
