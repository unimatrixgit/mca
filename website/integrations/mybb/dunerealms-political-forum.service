[Unit]
Description=DuneRealms elected office forum synchronization
After=network-online.target
[Service]
Type=simple
User=dunerealms
Group=dunerealms
EnvironmentFile=/home/dunerealms/.config/dunerealms.env
ExecStart=/home/dunerealms/.nvm/versions/node/v22.23.3/bin/node /home/dunerealms/apps/integrations/mybb/watch-political-offices.mjs
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
